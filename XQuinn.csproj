<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--<TargetFramework>net48</TargetFramework>-->
    <TargetFrameworks>net10.0-windows;net6.0-windows;netstandard2.0</TargetFrameworks>
 <!--Qud support requires netstandard2.0, bep6 requires net6. net48 is for testing the netstandard2.0 version.-->
 <!--<ImplicitUsings>enable</ImplicitUsings>-->
    <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>false</SelfContained>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>9.0</LangVersion> <!--For caves of qud support exclusively.-->
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  <!-- <GenerateDocumentationFile>true</GenerateDocumentationFile> 
      <NoWarn>$(NoWarn);1591</NoWarn>--> 
  <!--  <TreatWarningsAsErrors>true</TreatWarningsAsErrors>-->
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
     <!-- <LangVersion>11.0</LangVersion> -->
  </PropertyGroup>

  <PropertyGroup Condition="$(LangVersion) == '11.0' Or $(LangVersion) == 'latest'"> <!--There are some lang features I miss from C# 11, such as static abstract interface methods, but right now we dont really use this constant-->
    <DefineConstants>$(DefineConstants);CSHARP_11_OR_GREATER</DefineConstants> <!--As you can see there is no setting to compile Net6+ into C# 11 as of right now-->
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!--  <LangVersion>9.0</LangVersion>-->
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Mono.Reflection" Version="2.0.0" />
    <PackageReference Include="System.Collections.Immutable" Version="10.0.11" /> <!--For NetStandard2.0 support, needs explicit inclusion -->
  </ItemGroup>

</Project>
